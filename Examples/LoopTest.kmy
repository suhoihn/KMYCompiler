// ===== BASIC WHILE =====
let x = 0;
while (x < 3) {
    print(x);
    x = x + 1;
}

// ===== WHILE NEVER ENTERS =====
let y = 10;
while (y < 5) {
    print(999);
}
print(y);

// ===== NESTED WHILE =====
let i = 0;
while (i < 2) {
    let j = 0;
    while (j < 2) {
        print(i + j);
        j = j + 1;
    }
    i = i + 1;
}

// ===== SCOPE SHADOWING =====
let a = 100;
let k = 0;
while (k < 2) {
    let a = k;
    print(a);
    k = k + 1;
}
print(a);

// ===== FOR LOOP BASIC =====
for (let m = 0; m < 3; m = m + 1) {
    print(m);
}

// ===== FOR LOOP WITH OUTER VAR =====
let sum = 0;
for (let n = 1; n <= 3; n = n + 1) {
    sum = sum + n;
}
print(sum);

// ===== NESTED FOR + WHILE =====
for (let p = 0; p < 2; p = p + 1) {
    let q = 0;
    while (q < 2) {
        print(p + q);
        q = q + 1;
    }
}

// ===== BIG STRESS TEST =====
let total = 0;
for (let u = 0; u < 3; u = u + 1) {
    let v = 0;
    while (v < 2) {
        total = total + u + v;
        v = v + 1;
    }
}
print(total);
