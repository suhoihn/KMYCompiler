// ===== BASIC WHILE =====
var x = 0;
while (x < 3) {
    print(x);
    x = x + 1;
}

// ===== WHILE NEVER ENTERS =====
var y = 10;
while (y < 5) {
    print(999);
}
print(y);

// ===== NESTED WHILE =====
var i = 0;
while (i < 2) {
    var j = 0;
    while (j < 2) {
        print(i + j);
        j = j + 1;
    }
    i = i + 1;
}

// ===== SCOPE SHADOWING =====
var a = 100;
var k = 0;
while (k < 2) {
    var a = k;
    print(a);
    k = k + 1;
}
print(a);

// ===== FOR LOOP BASIC =====
for (var m = 0; m < 3; m = m + 1) {
    print(m);
}

// ===== FOR LOOP WITH OUTER VAR =====
var sum = 0;
for (var n = 1; n <= 3; n = n + 1) {
    sum = sum + n;
}
print(sum);

// ===== NESTED FOR + WHILE =====
for (var p = 0; p < 2; p = p + 1) {
    var q = 0;
    while (q < 2) {
        print(p + q);
        q = q + 1;
    }
}

// ===== BIG STRESS TEST =====
var total = 0;
for (var u = 0; u < 3; u = u + 1) {
    var v = 0;
    while (v < 2) {
        total = total + u + v;
        v = v + 1;
    }
}
print(total);
