fun concat(a, b, c) {
    var result = [];

    for (var i = 0; i < len(a); i = i + 1) {
        append(result, a[i]);
    }

    for (var i = 0; i < len(b); i = i + 1) {
        append(result, b[i]);
    }

    for (var i = 0; i < len(c); i = i + 1) {
        append(result, c[i]);
    }

    return result;
}

fun quicksort(arr) {
    // Base case: already sorted
    if (len(arr) <= 1) {
        return arr;
    }

    var pivot = arr[0];

    var less = [];
    var equal = [];
    var greater = [];

    // Partition
    for (var i = 0; i < len(arr); i = i + 1) {
        if (arr[i] < pivot) {
            append(less, arr[i]);
        } else if (arr[i] > pivot) {
            append(greater, arr[i]);
        } else {
            append(equal, arr[i]);
        }
    }

    // Recursively sort subarrays
    var sortedLess = quicksort(less);
    var sortedGreater = quicksort(greater);

    // Return a NEW sorted array
    return concat(sortedLess, equal, sortedGreater);
}

// --- test ---
var input = [5, 3, 8, 1, 2, 7, 4, 6];

var output = quicksort(input);

print(output);   // [1,2,3,4,5,6,7,8]
print(input);    // original unchanged (important!)
