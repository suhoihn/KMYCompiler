// =========================================
// BREAK / CONTINUE CFG TEST SUITE
// =========================================

// -----------------------------------------
// 1. SIMPLE BREAK
// Expected:
// 0
// 1
// 2
// 999
// -----------------------------------------

var i = 0;

while (i < 10) {
    if (i == 3) {
        break;
    }

    print(i);
    i = i + 1;
}

print(999);


// -----------------------------------------
// 2. SIMPLE CONTINUE
// Expected:
// 1
// 2
// 4
// 5
// -----------------------------------------

var j = 0;

while (j < 5) {
    j = j + 1;

    if (j == 3) {
        continue;
    }

    print(j);
}


// -----------------------------------------
// 3. NESTED BREAK
// Expected:
// 0
// 10
// 20
// -----------------------------------------

var a = 0;

while (a < 3) {
    var b = 0;

    while (b < 3) {
        if (b == 1) {
            break;
        }

        print(a * 10 + b);
        b = b + 1;
    }

    a = a + 1;
}


// -----------------------------------------
// 4. CONTINUE ONLY INNER LOOP
// Expected:
// 1
// 3
// 4
// 11
// 13
// 14
// -----------------------------------------

var c = 0;

while (c < 2) {
    var d = 0;

    while (d < 4) {
        d = d + 1;

        if (d == 2) {
            continue;
        }

        print(c * 10 + d);
    }

    c = c + 1;
}


// -----------------------------------------
// 5. BREAK + CONTINUE COMBINED
// Expected:
// 1
// 2
// 4
// 5
// 6
// 999
// -----------------------------------------

var e = 0;

while (e < 10) {
    e = e + 1;

    if (e == 3) {
        continue;
    }

    if (e == 7) {
        break;
    }

    print(e);
}

print(999);


// -----------------------------------------
// 6. CONTINUE AT TOP OF LOOP
// Expected:
// 3
// 4
// -----------------------------------------

var f = 0;

while (f < 5) {
    f = f + 1;

    if (f < 3) {
        continue;
    }

    print(f);
}


// -----------------------------------------
// 7. BREAK IMMEDIATELY
// Expected:
// 123
// -----------------------------------------

while (1) {
    break;
}

print(123);


// -----------------------------------------
// 8. NESTED BREAK + OUTER CONTINUE
// Expected:
// 0
// 10
// 20
// -----------------------------------------

var g = 0;

while (g < 3) {
    var h = 0;

    while (h < 5) {
        print(g * 10 + h);
        break;
    }

    g = g + 1;
    continue;
}


// -----------------------------------------
// 9. DEEP NESTING STRESS TEST
// Expected:
// 0
// 1
// 10
// 11
// -----------------------------------------

var x = 0;

while (x < 2) {
    var y = 0;

    while (y < 2) {
        var z = 0;

        while (z < 3) {
            if (z == 1) {
                break;
            }

            print(x * 10 + y);
            z = z + 1;
        }

        y = y + 1;
    }

    x = x + 1;
}


// -----------------------------------------
// END OF TESTS
// -----------------------------------------

print(777777);