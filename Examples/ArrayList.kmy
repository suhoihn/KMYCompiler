// Fixed-capacity integer ArrayList for the native x86 backend.
// The backing array never resizes; size tracks the live prefix.
class ArrayList {
    let data: int[16] = new int[16];
    let size: int = 0;
    let capacity: int = 16;

    init() {}

    fun add(value: int): bool {
        if (this.size >= this.capacity) {
            return false;
        }

        this.data[this.size] = value;
        this.size = this.size + 1;
        return true;
    }

    fun get(index: int): int {
        if (index < 0 || index >= this.size) {
            return -1;
        }
        return this.data[index];
    }

    fun set(index: int, value: int): bool {
        if (index < 0 || index >= this.size) {
            return false;
        }

        this.data[index] = value;
        return true;
    }

    fun remove(index: int): int {
        if (index < 0 || index >= this.size) {
            return -1;
        }

        let removed: int = this.data[index];
        let i: int = index;

        while (i + 1 < this.size) {
            this.data[i] = this.data[i + 1];
            i = i + 1;
        }

        this.size = this.size - 1;
        this.data[this.size] = 0;
        return removed;
    }

    fun clear() {
        this.size = 0;
    }

    fun length(): int {
        return this.size;
    }

    fun isEmpty(): bool {
        return this.size == 0;
    }

    fun contains(value: int): bool {
        let i: int = 0;
        while (i < this.size) {
            if (this.data[i] == value) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    fun indexOf(value: int): int {
        let i: int = 0;
        while (i < this.size) {
            if (this.data[i] == value) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
};

let list: ArrayList = new ArrayList();
list.add(10);
list.add(20);
list.add(30);

print(list.get(1));
print(list.remove(1));
print(list.get(1));
print(list.length());
print(list.contains(30));
print(list.indexOf(30));
