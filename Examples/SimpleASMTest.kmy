class Counter {
    var value: int = 10;

    init(start: int) {
        this.value = start;
    }

    fun dec(): int {
        this.value -= 1;
        return this.value;
    }

    fun inc(): int {
        this.value += 1;
        return this.value;
    }
};

var c: Counter = new Counter(4);
while (c.dec() > 0) {
    print(c.inc());
}
