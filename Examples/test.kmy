        return 42;
    }
    
    // TODO: Must ignore the stuff annotated on init. makes no sense.
    init(name: string): void {
        print("Starting X. (1)");
        print("Hello " + name);
        this.name = name;
    }

    init(name: string, age: int) {
        print("Starting X. (2)");
        print("Your age is ");
        print(age);
        this.name = name;
        this.age = age;
    }

    fun adder_method(a: int, b: int): int { 
        print(this);
        return a + b;
    }
};

