let const INVALID_AGE: int = -1;
class X {
    // FIX: without "any" fails.
    let adder: any = fun (a: int, b:int): int { return a + b; };
    let name: string;
    let age: int = INVALID_AGE;
    
    // Must ignore the stuff annotated on init. makes no sense.
    init(const name: string): void {
        print("Starting X. (1)");
        print("Hello " + name);
        this.name = name;
    }

    init(name: string, age: int) {
        print("Starting X. (2)");
        print("Your age is ");
        print(age);
        this.name = name;
        this.age = age;
    }

    fun adder_method(a: int, b:int): int { 
        return a + b;
    }
};

let suho: X = new X("suho");
//let kmy: X = new X("KMY", 1972);

print(suho.name);

print(suho.adder(10,20));
print(suho.adder_method(10, 20));

