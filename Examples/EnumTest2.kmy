class Main {
    class InnerClass {
        init() {
            print("hi");
        }
    };

    enum Gender {
        MALE,
        FEMALE,
        NEUTRAL,
        SLIGHTLY_MALE,
        SLIGHTLY_FEMALE
    };

    enum Power {
        MYULCHEE,
        YAKGOL,
        PYEONGBUM,
        TUNTUN,
        MACHO
    };

    var g: Main::Gender;
    var p: Main::Power;

    // Good note: Supports just Gender
    init(g: Gender, p: Main::Power) {
        this.g = g;
        this.p = p;
    }
};

typealias x = Main;

var i = new Main(Main::Gender::MALE, Main::Power::PYEONGBUM);
print(i);

enum X{a,b,c};

print(Main::Power::MACHO);

