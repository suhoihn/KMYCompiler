class Main {
    enum Gender {
        MALE,
        FEMALE,
        NEUTRAL,
        SLIGHTLY_MALE,
        SLIGHTLY_FEMALE
    };

    enum Power {
        MYULCHEE,
        YAKGOL,
        PYEONGBUM,
        TUNTUN,
        MACHO
    };

    let g: Main::Gender;
    let p: Main::Power;

    // Good note: Supports just Gender
    init(const g: Gender, const p: Main::Power) {
        this.g = g;
        this.p = p;
    }
};

let i = new Main(Main::Gender::MALE, Main::Power::PYEONGBUM);
print(i);

enum X{a,b,c};

print(Main::Power::MACHO);

