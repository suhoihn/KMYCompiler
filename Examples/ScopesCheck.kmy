let x = 1;
print(x);        // 1

{
    let x = 2;
    print(x);    // 2

    {
        let x = 3;
        print(x); // 3
    }

    print(x);    // 2
}

print(x);        // 1


// mutation across scopes
let y = 10;

{
    y = 20;
    print(y);    // 20
}

print(y);        // 20


// shadow + assignment expression
let z = 5;

{
    let z = 100;
    z = z + 1;
    print(z);    // 101
}

print(z);        // 5


// nested shadow + reuse
let a = 1;

{
    let a = 2;

    {
        let a = 3;
        print(a); // 3
    }

    print(a);     // 2
}

print(a);         // 1


// scope leak test (VERY IMPORTANT)
{
    let t = 999;
    print(t);     // 999
}

// this should ERROR at compile time
// print(t);         // ❌ undefined variable


// const enforcement
let const c = 50;
print(c);         // 50

// c = 60;           // ❌ should fail


// redeclaration in same scope
{
    let q = 1;
    //let q = 2;    // ❌ should fail
}