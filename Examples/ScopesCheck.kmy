var x = 1;
print(x);        // 1

{
    var x = 2;
    print(x);    // 2

    {
        var x = 3;
        print(x); // 3
    }

    print(x);    // 2
}

print(x);        // 1


// mutation across scopes
var y = 10;

{
    y = 20;
    print(y);    // 20
}

print(y);        // 20


// shadow + assignment expression
var z = 5;

{
    var z = 100;
    z = z + 1;
    print(z);    // 101
}

print(z);        // 5


// nested shadow + reuse
var a = 1;

{
    var a = 2;

    {
        var a = 3;
        print(a); // 3
    }

    print(a);     // 2
}

print(a);         // 1


// scope leak test (VERY IMPORTANT)
{
    var t = 999;
    print(t);     // 999
}

// this should ERROR at compile time
// print(t);         // ❌ undefined variable


// const enforcement
let c = 50;
print(c);         // 50

// c = 60;           // ❌ should fail


// redeclaration in same scope
{
    var q = 1;
    //let q = 2;    // ❌ should fail
}