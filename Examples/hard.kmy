// =======================
// FINAL MIXED STRESS TEST
// =======================
print("=== FINAL MIXED TEST ===");

fun fact2(n) {
    if (n == 0) {
        return 1;
    }
    return n * fact2(n - 1);
}

fun square2(x) {
    return x * x;
}

fun cube(x) {
    return x * x * x;
}

let funcs = [fact2, square2, cube];

let k = 0;

while (k < 6) {
    let fn = funcs[k % 3];

    if (k % 3 == 0) {
        print("fact");
    } else if (k % 3 == 1) {
        print("square");
    } else {
        print("cube");
    }

    print(fn(k + 1));

    k = k + 1;
}
