// For each block:
//   IN[B]  = vars definitely assigned on entry
//    OUT[B] = vars definitely assigned on exit

//OUT[B] = GEN[B] ∪ (IN[B] - KILL[B])
//IN[B]  = intersection of predecessors' OUTs

fun f(): void {
    let x = 3;
    let w = 5;
    fun g(): (int)->void {
        let y = 4;
        print(w);
        fun h(t: int): void {
            print(y + x + w + t);
        }
        return h;
    }
    g()(10); // Allowed thanks to hoisting.
}
f();