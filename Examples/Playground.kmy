typealias C = B;
typealias B = A;
typealias A = C;

let x = 42;
outer();

fun outer() {
    print("1. I am outer.");
    let y = middle();
    fun middle() {
        fun inner() {
            x += x;
            print("3. I am inner.");
        }
        return inner;
    }
    print("2. I am middle.");
    y();
}

print(x);
print("Am I 84?");