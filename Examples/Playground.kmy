var matrix = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
];

var matrixp = &matrix;
var rowp = &((*matrixp)[1]);
var elemp = &((*rowp)[2]);

*elemp = 69;

print(matrix[1][2]); // 69


enum Color {
    Red,
    Green,
    Blue
};

var x = Color::Red;
let px = &x;
let y = Color::Red;
let py = &y;

print(px == py); // false

fun printColor(c: Color*) {
    if (*c == Color::Red) {
        print("Red");
    } else if (*c == Color::Green) {
        print("Green");
    } else if (*c == Color::Blue) {
        print("Blue");
    }
}

printColor(px); // Red
