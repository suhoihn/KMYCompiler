let matrix = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
];

let matrixp = &matrix;
let rowp = &((*matrixp)[1]);
let elemp = &((*rowp)[2]);

*elemp = 69;

print(matrix[1][2]); // 69


enum Color {
    Red,
    Green,
    Blue
};

let x = Color::Red;
let const px = &x;
let const y = Color::Red;
let const py = &y;

print(px == py); // false

fun printColor(const c: Color*) {
    if (*c == Color::Red) {
        print("Red");
    } else if (*c == Color::Green) {
        print("Green");
    } else if (*c == Color::Blue) {
        print("Blue");
    }
}

printColor(px); // Red