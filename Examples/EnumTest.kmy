// ===== ENUM DEFINITIONS =====

enum Color {
    RED,
    GREEN,
    BLUE
};

enum Direction {
    NORTH,
    SOUTH,
    EAST,
    WEST
};

// ===== VARIABLES (typed) =====

var a: Color = Color::RED;
var b: any = Color::GREEN;
var c: Color = Color::BLUE;

var d: Direction = Direction::NORTH;
var e: Direction = Direction::WEST;

// same-type assignment
var f: Color = a;
var g: Direction = d;

// ===== EXPRESSIONS =====

var x: Color = Color::RED;
var y: Color = Color::GREEN;

var z: Color = x;
var w: Color = Color::BLUE;

// numeric sanity check (should NOT treat enum as int unless you allow it)
var i: int = 10;
var j: int = i + 5;

// ===== COMPARISONS =====

var check1: bool = x == Color::RED;
var check2: bool = y == Color::BLUE;
var check3: bool = d == Direction::NORTH;

// ===== IF STATEMENT =====
var result: int;
if (x == Color::RED) {
    result = 1;
} else {
    result = 0;
}
// ===== WHILE LOOP =====

var counter: int = 0;

while (counter < 5) {
    counter = counter + 1;
}

// ===== FUNCTION TEST =====

fun testEnum(v: Color): int {
    if (v == Color::GREEN) {
        return 100;
    } else {
        return 200;
    }
}

// ===== CALLS =====

var r1: int = testEnum(Color::RED);
var r2: int = testEnum(Color::BLUE);

// ===== EDGE CASES =====

// reassign enum
var m: Color = Color::RED;
m = Color::GREEN;

// nested usage
var n: Color = Color::RED;
var p: Color = n;
