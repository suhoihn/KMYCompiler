// Basic data structures implemented entirely in KMY.
class IntStack {
    var data: int[] = new int[4];
    var size: int = 0;
    var capacity: int = 4;

    init() {}

    fun push(value: int) {
        if (this.size >= this.capacity) {
            var newCapacity: int = this.capacity * 2;
            var expanded: int[] = new int[newCapacity];
            var i: int = 0;
            while (i < this.size) {
                expanded[i] = this.data[i];
                i += 1;
            }
            this.data = expanded;
            this.capacity = newCapacity;
        }
        this.data[this.size] = value;
        this.size += 1;
    }

    fun pop(): int {
        if (this.size == 0) { return -1; }
        this.size -= 1;
        return this.data[this.size];
    }
};

class IntQueue {
    var data: int[] = new int[4];
    var head: int = 0;
    var tail: int = 0;
    var size: int = 0;
    var capacity: int = 4;

    init() {}

    fun enqueue(value: int): bool {
        if (this.size >= this.capacity) { return false; }
        this.data[this.tail] = value;
        this.tail = (this.tail + 1) % this.capacity;
        this.size += 1;
        return true;
    }

    fun dequeue(): int {
        if (this.size == 0) { return -1; }
        var value: int = this.data[this.head];
        this.head = (this.head + 1) % this.capacity;
        this.size -= 1;
        return value;
    }
};

var stack: IntStack = new IntStack();
stack.push(10);
stack.push(20);
stack.push(30);
print(stack.pop());
print(stack.pop());

var queue: IntQueue = new IntQueue();
queue.enqueue(7);
queue.enqueue(8);
print(queue.dequeue());
print(queue.dequeue());
