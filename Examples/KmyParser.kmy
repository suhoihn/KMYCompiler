// First self-hosted parser slice. This is one file until KMY has modules.
// It parses source text; it does not execute or type-check that source.
// Grammar:
//   program    -> statement* EOF
//   statement  -> 'let' IDENT (':' IDENT '*')? ('=' expression)? ';'
//               | expression ';'
//   expression -> assignment
//   assignment -> additive ('=' assignment)?
//   additive   -> product (('+' | '-') product)*
//   product    -> unary (('*' | '/') unary)*
//   unary      -> ('+' | '-' | '&' | '*') unary | call
//   call       -> primary ('(' expression? ')')*
//   primary    -> INT | IDENT | '(' expression ')'
// Calls are deliberately limited to zero or one argument in this slice.

class KmyTokenBuffer {
    let kinds: string[] = new string[4];
    let lexemes: string[] = new string[4];
    let size: int = 0;
    let capacity: int = 4;

    init() {}

    fun add(kind: string, lexeme: string) {
        if (this.size == this.capacity) {
            let newCapacity: int = this.capacity * 2;
            let newKinds: string[] = new string[newCapacity];
            let newLexemes: string[] = new string[newCapacity];
            let i: int = 0;
            while (i < this.size) {
                newKinds[i] = this.kinds[i];
                newLexemes[i] = this.lexemes[i];
                i += 1;
            }
            this.kinds = newKinds;
            this.lexemes = newLexemes;
            this.capacity = newCapacity;
        }
        this.kinds[this.size] = kind;
        this.lexemes[this.size] = lexeme;
        this.size += 1;
    }
};

class KmySourceLexer {
    let source: string;
    let length: int = 0;
    let position: int = 0;
    let tokens: KmyTokenBuffer;

    init(source: string) {
        this.source = source;
        this.length = strlen(source);
        this.tokens = new KmyTokenBuffer();
    }

    fun isDigit(value: int): bool {
        return value >= 48 && value <= 57;
    }

    fun isLetter(value: int): bool {
        return (value >= 65 && value <= 90) ||
               (value >= 97 && value <= 122) || value == 95;
    }

    fun scanWord() {
        let word: string = "";
        while (this.position < this.length &&
               (this.isLetter(strByteAt(this.source, this.position)) ||
                this.isDigit(strByteAt(this.source, this.position)))) {
            word = strconcat(word, strFromByte(strByteAt(this.source, this.position)));
            this.position += 1;
        }
        if (streq(word, "let")) {
            this.tokens.add("LET", word);
        } else {
            this.tokens.add("IDENT", word);
        }
    }

    fun scanNumber() {
        let number: string = "";
        while (this.position < this.length &&
               this.isDigit(strByteAt(this.source, this.position))) {
            number = strconcat(number, strFromByte(strByteAt(this.source, this.position)));
            this.position += 1;
        }
        this.tokens.add("INT", number);
    }

    fun scan() {
        while (this.position < this.length) {
            let value: int = strByteAt(this.source, this.position);
            if (value == 32 || value == 9 || value == 10 || value == 13) {
                this.position += 1;
            } else if (value == 47 && this.position + 1 < this.length &&
                       strByteAt(this.source, this.position + 1) == 47) {
                while (this.position < this.length &&
                       strByteAt(this.source, this.position) != 10) {
                    this.position += 1;
                }
            } else if (this.isLetter(value)) {
                this.scanWord();
            } else if (this.isDigit(value)) {
                this.scanNumber();
            } else if (value == 43) {
                this.tokens.add("PLUS", "+");
                this.position += 1;
            } else if (value == 45) {
                this.tokens.add("MINUS", "-");
                this.position += 1;
            } else if (value == 42) {
                this.tokens.add("STAR", "*");
                this.position += 1;
            } else if (value == 47) {
                this.tokens.add("SLASH", "/");
                this.position += 1;
            } else if (value == 38) {
                this.tokens.add("AMP", "&");
                this.position += 1;
            } else if (value == 61) {
                this.tokens.add("ASSIGN", "=");
                this.position += 1;
            } else if (value == 58) {
                this.tokens.add("COLON", ":");
                this.position += 1;
            } else if (value == 59) {
                this.tokens.add("SEMI", ";");
                this.position += 1;
            } else if (value == 40) {
                this.tokens.add("LPAREN", "(");
                this.position += 1;
            } else if (value == 41) {
                this.tokens.add("RPAREN", ")");
                this.position += 1;
            } else {
                this.tokens.add("UNKNOWN", strFromByte(value));
                this.position += 1;
            }
        }
        this.tokens.add("EOF", "<EOF>");
    }
};

class KmyAstNode {
    let kind: string;
    let text: string;
    let left: KmyAstNode? = null;
    let right: KmyAstNode? = null;
    let next: KmyAstNode? = null;

    // Native calls currently fit only the env, receiver, and two explicit
    // arguments in registers. Attach child nodes after construction.
    init(kind: string, text: string) {
        this.kind = kind;
        this.text = text;
    }

    fun withLeft(node: KmyAstNode?): KmyAstNode {
        this.left = node;
        return this;
    }

    fun withRight(node: KmyAstNode?): KmyAstNode {
        this.right = node;
        return this;
    }

    fun isBinary(): bool {
        return streq(this.kind, "add") || streq(this.kind, "subtract") ||
               streq(this.kind, "multiply") || streq(this.kind, "divide") ||
               streq(this.kind, "assign");
    }

    fun isUnary(): bool {
        return streq(this.kind, "positive") || streq(this.kind, "negative") ||
               streq(this.kind, "address") || streq(this.kind, "deref");
    }

    fun operatorSymbol(): string {
        if (streq(this.kind, "add") || streq(this.kind, "positive")) { return "+"; }
        if (streq(this.kind, "subtract") || streq(this.kind, "negative")) { return "-"; }
        if (streq(this.kind, "multiply") || streq(this.kind, "deref")) { return "*"; }
        if (streq(this.kind, "divide")) { return "/"; }
        if (streq(this.kind, "address")) { return "&"; }
        if (streq(this.kind, "assign")) { return "="; }
        return "?";
    }

    fun precedence(): int {
        if (streq(this.kind, "assign")) { return 10; }
        if (streq(this.kind, "add") || streq(this.kind, "subtract")) { return 100; }
        if (streq(this.kind, "multiply") || streq(this.kind, "divide")) { return 110; }
        if (this.isUnary()) { return 120; }
        if (streq(this.kind, "call")) { return 130; }
        return 1000; // Names and literals never need parentheses.
    }

    // Reconstruct readable KMY, adding parentheses only when the AST's
    // grouping would otherwise change. The right child of a left-associative
    // operator gets a higher required precedence to preserve cases like
    // `a - (b - c)`.
    fun renderSource(parentPrecedence: int): string {
        if (streq(this.kind, "int") || streq(this.kind, "name")) {
            return this.text;
        }

        let ownPrecedence: int = this.precedence();
        let body: string = "";
        if (this.isUnary()) {
            body = strconcat(this.operatorSymbol(), this.left!!.renderSource(ownPrecedence));
        } else if (streq(this.kind, "call")) {
            body = strconcat(this.left!!.renderSource(ownPrecedence), "(");
            if (this.right) {
                body = strconcat(body, this.right!!.renderSource(0));
            }
            body = strconcat(body, ")");
        } else if (this.isBinary()) {
            let leftPrecedence: int = ownPrecedence;
            let rightPrecedence: int = ownPrecedence + 1;
            if (streq(this.kind, "assign")) {
                // Assignment is right-associative: a = b = c.
                leftPrecedence = ownPrecedence + 1;
                rightPrecedence = ownPrecedence;
            }
            body = this.left!!.renderSource(leftPrecedence);
            body = strconcat(body, strconcat(" ", this.operatorSymbol()));
            body = strconcat(body, " ");
            body = strconcat(body, this.right!!.renderSource(rightPrecedence));
        } else {
            return "<unknown expression>";
        }

        if (ownPrecedence < parentPrecedence) {
            return strconcat(strconcat("(", body), ")");
        }
        return body;
    }

    fun renderStatement(): string {
        if (streq(this.kind, "let")) {
            let result: string = strconcat("let ", this.text);
            if (streq(this.right!!.text, "inferred") == false) {
                result = strconcat(strconcat(result, ": "), this.right!!.text);
            }
            if (this.left) {
                result = strconcat(strconcat(result, " = "), this.left!!.renderSource(0));
            }
            return strconcat(result, ";");
        }
        return strconcat(this.renderSource(0), ";");
    }

    fun treeLabel(): string {
        if (streq(this.kind, "let")) {
            let result: string = strconcat("let ", this.text);
            if (streq(this.right!!.text, "inferred") == false) {
                result = strconcat(strconcat(result, ": "), this.right!!.text);
            }
            return result;
        }
        if (streq(this.kind, "int")) { return strconcat("integer ", this.text); }
        if (streq(this.kind, "name")) { return strconcat("name ", this.text); }
        if (streq(this.kind, "call")) { return "call"; }
        if (streq(this.kind, "assign")) { return "assignment (=)"; }
        if (streq(this.kind, "address")) { return "address-of (&)"; }
        if (streq(this.kind, "deref")) { return "dereference (*)"; }
        if (streq(this.kind, "positive")) { return "unary plus (+)"; }
        if (streq(this.kind, "negative")) { return "unary minus (-)"; }
        return strconcat(strconcat(this.kind, " ("), strconcat(this.operatorSymbol(), ")"));
    }

    // `role` makes child relationships visible instead of relying on the
    // reader to remember S-expression argument positions.
    fun renderTree(indent: string, role: string): string {
        let output: string = strconcat(strconcat(indent, role), this.treeLabel());
        output = strconcat(output, strFromByte(10));
        let childIndent: string = strconcat(indent, "  ");
        if (this.left) {
            let leftRole: string = "left: ";
            if (streq(this.kind, "let")) { leftRole = "initializer: "; }
            if (streq(this.kind, "call")) { leftRole = "callee: "; }
            if (this.isUnary()) { leftRole = "operand: "; }
            if (streq(this.kind, "assign")) { leftRole = "target: "; }
            output = strconcat(output, this.left!!.renderTree(childIndent, leftRole));
        }
        if (this.right && streq(this.kind, "let") == false) {
            let rightRole: string = "right: ";
            if (streq(this.kind, "call")) { rightRole = "argument: "; }
            if (streq(this.kind, "assign")) { rightRole = "value: "; }
            output = strconcat(output, this.right!!.renderTree(childIndent, rightRole));
        }
        return output;
    }
};

class KmySourceParser {
    let tokens: KmyTokenBuffer;
    let position: int = 0;
    let failed: bool = false;
    let error: string = "";
    let first: KmyAstNode? = null;

    init(tokens: KmyTokenBuffer) {
        this.tokens = tokens;
    }

    fun check(kind: string): bool {
        return streq(this.tokens.kinds[this.position], kind);
    }

    fun match(kind: string): bool {
        if (this.check(kind)) {
            this.position += 1;
            return true;
        }
        return false;
    }

    fun fail(expected: string) {
        if (this.failed == false) {
            this.error = strconcat(
                strconcat("Expected ", expected),
                strconcat(" near '", strconcat(this.tokens.lexemes[this.position], "'"))
            );
            this.failed = true;
        }
    }

    fun consume(kind: string): string {
        if (this.check(kind) == false) {
            this.fail(kind);
            return "";
        }
        let value: string = this.tokens.lexemes[this.position];
        this.position += 1;
        return value;
    }

    fun badNode(): KmyAstNode {
        return new KmyAstNode("error", "");
    }

    fun primary(): KmyAstNode {
        if (this.check("INT")) {
            return new KmyAstNode("int", this.consume("INT"));
        }
        if (this.check("IDENT")) {
            return new KmyAstNode("name", this.consume("IDENT"));
        }
        if (this.match("LPAREN")) {
            let inside: KmyAstNode = this.expression();
            this.consume("RPAREN");
            return inside;
        }
        this.fail("an integer, name, or '('");
        return this.badNode();
    }

    fun call(): KmyAstNode {
        let callee: KmyAstNode = this.primary();
        while (this.failed == false && this.match("LPAREN")) {
            let argument: KmyAstNode? = null;
            if (this.check("RPAREN") == false) {
                argument = this.expression();
            }
            this.consume("RPAREN");
            callee = new KmyAstNode("call", "").withLeft(callee).withRight(argument);
        }
        return callee;
    }

    fun unary(): KmyAstNode {
        if (this.match("PLUS")) {
            return new KmyAstNode("positive", "").withLeft(this.unary());
        }
        if (this.match("MINUS")) {
            return new KmyAstNode("negative", "").withLeft(this.unary());
        }
        if (this.match("AMP")) {
            return new KmyAstNode("address", "").withLeft(this.unary());
        }
        if (this.match("STAR")) {
            return new KmyAstNode("deref", "").withLeft(this.unary());
        }
        return this.call();
    }

    fun product(): KmyAstNode {
        let left: KmyAstNode = this.unary();
        while (this.failed == false && (this.check("STAR") || this.check("SLASH"))) {
            if (this.match("STAR")) {
                left = new KmyAstNode("multiply", "").withLeft(left).withRight(this.unary());
            } else {
                this.consume("SLASH");
                left = new KmyAstNode("divide", "").withLeft(left).withRight(this.unary());
            }
        }
        return left;
    }

    fun additive(): KmyAstNode {
        let left: KmyAstNode = this.product();
        while (this.failed == false && (this.check("PLUS") || this.check("MINUS"))) {
            if (this.match("PLUS")) {
                left = new KmyAstNode("add", "").withLeft(left).withRight(this.product());
            } else {
                this.consume("MINUS");
                left = new KmyAstNode("subtract", "").withLeft(left).withRight(this.product());
            }
        }
        return left;
    }

    fun expression(): KmyAstNode {
        let left: KmyAstNode = this.additive();
        if (this.failed == false && this.match("ASSIGN")) {
            if (streq(left.kind, "name") == false && streq(left.kind, "deref") == false) {
                this.fail("a variable or dereference on the left of '='");
                return this.badNode();
            }
            return new KmyAstNode("assign", "").withLeft(left).withRight(this.expression());
        }
        return left;
    }

    fun statement(): KmyAstNode {
        if (this.match("LET")) {
            let name: string = this.consume("IDENT");
            let typeName: string = "inferred";
            if (this.match("COLON")) {
                typeName = this.consume("IDENT");
                while (this.match("STAR")) {
                    typeName = strconcat(typeName, "*");
                }
            }
            let initializer: KmyAstNode? = null;
            if (this.match("ASSIGN")) {
                initializer = this.expression();
            }
            this.consume("SEMI");
            return new KmyAstNode("let", name)
                .withLeft(initializer)
                .withRight(new KmyAstNode("type", typeName));
        }
        let value: KmyAstNode = this.expression();
        this.consume("SEMI");
        return value;
    }

    fun parse() {
        let last: KmyAstNode? = null;
        while (this.failed == false && this.check("EOF") == false) {
            let node: KmyAstNode = this.statement();
            if (this.failed == false) {
                if (last) {
                    last!!.next = node;
                } else {
                    this.first = node;
                }
                last = node;
            }
        }
    }

    fun render(): string {
        let newline: string = strFromByte(10);
        let preview: string = strconcat(strconcat("KMY preview", newline),
                                         strconcat("-----------", newline));
        let tree: string = strconcat(strconcat(newline, "AST"),
                                      strconcat(newline, strconcat("---", newline)));
        let node: KmyAstNode? = this.first;
        while (node) {
            preview = strconcat(preview, node!!.renderStatement());
            preview = strconcat(preview, strFromByte(10));
            tree = strconcat(tree, node!!.renderTree("  ", ""));
            tree = strconcat(tree, strFromByte(10));
            node = node!!.next;
        }
        return strconcat(preview, tree);
    }
};

let source: string = readFile("Examples/KmyParserInput.kmy");
let lexer: KmySourceLexer = new KmySourceLexer(source);
lexer.scan();
let parser: KmySourceParser = new KmySourceParser(lexer.tokens);
parser.parse();
if (parser.failed) {
    print(strconcat("PARSE ERROR: ", parser.error));
} else {
    let ast: string = parser.render();
    if (writeFile("build/kmy_parser_ast.txt", ast)) {
        print(ast);
    } else {
        print("Could not write build/kmy_parser_ast.txt");
    }
}
