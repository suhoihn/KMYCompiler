
/////////////////////////////
// ARRAY STRESS TEST SUITE //
/////////////////////////////

// 1. Basic creation + access
var a = [1, 2, 3, 4, 5];

print(a[0]);
print(a[1]);
print(a[2]);
print(a[3]);
print(a[4]);

/////////////////////////////
// 2. Overwrite test
/////////////////////////////

a[0] = 99;
a[4] = 100;
a[2] = a[1];

print(a[0]);
print(a[1]);
print(a[2]);
print(a[3]);
print(a[4]);

/////////////////////////////
// 3. Boundary stress
/////////////////////////////

// print(a[10]);
// print(a[100]);
// print(a[999]);

/////////////////////////////
// 4. Nested arrays
/////////////////////////////

var b = [
    [1, 2],
    [3, 4],
    [5, 6]
];

print(b[0][0]);
print(b[0][1]);
print(b[1][0]);
print(b[1][1]);
print(b[2][0]);
print(b[2][1]);

/////////////////////////////
// 5. Nested assignment
/////////////////////////////

b[0][0] = 42;
b[1][1] = b[0][0];
b[2][1] = b[1][1];

print(b[0][0]);
print(b[1][1]);
print(b[2][1]);

/////////////////////////////
// 6. Evaluation order test
/////////////////////////////

var c = [0, 1, 2];

print(c[c[0]]);
print(c[c[1 % 3]]);
print(c[c[2 - 1]]);

/////////////////////////////
// 7. Self-referencing patterns
/////////////////////////////

c[0] = c[1];
c[1] = c[2];
c[2] = c[0];

print(c[0]);
print(c[1]);
print(c[2]);

/////////////////////////////
// 8. Repeated access stress
/////////////////////////////

print(c[0]); print(c[1]); print(c[2]);
print(c[0]); print(c[1]); print(c[2]);
print(c[0]); print(c[1]); print(c[2]);

/////////////////////////////
// 9. Deep chain stress
/////////////////////////////

var d = [[[1]]];

print(d[0][0][0]);

d[0][0][0] = 777;

print(d[0][0][0]);

/////////////////////////////
// 10. Out-of-bounds stress
/////////////////////////////

//print(c[-1]);
//print(c[999]);
//print(c[1000000]);

/////////////////////////////
// 11. Weird expressions for indexing
/////////////////////////////

var arr = [1, 2, 3];
var idx = 0;
print(arr[idx + 1]);
print(arr[--1]);

/////////////////////////////
// END TEST
/////////////////////////////