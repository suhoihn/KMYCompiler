class StringOption {
    let present: bool = false;
    let value: string = "";
    init() {
    }
    fun set(value: string) {
        this.value = value;
        this.present = true;
    }
    fun clear() {
        this.present = false;
    }
    fun getOr(fallback: string): string {
        if (this.present) {
            return this.value;
        }
        return fallback;
    }
    fun isSome(): bool {
        return this.present;
    }
};
