fun rangeSum(start: int, endExclusive: int): int {
    var total: int = 0;
    var value: int = start;
    while (value < endExclusive) {
        total += value;
        value += 1;
    }
    return total;
}
fun rangeCount(start: int, endExclusive: int): int {
    if (endExclusive <= start) {
        return 0;
    }
    return endExclusive - start;
}
