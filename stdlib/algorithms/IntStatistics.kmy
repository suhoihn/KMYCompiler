fun average(values: int[], length: int): int {
    if (length == 0) {
        return 0;
    }
    var total: int = 0;
    var i: int = 0;
    while (i < length) {
        total += values[i];
        i += 1;
    }
    return total / length;
}
fun minimum(values: int[], length: int): int {
    if (length == 0) {
        return -1;
    }
    var best: int = values[0];
    var i: int = 1;
    while (i < length) {
        if (values[i] < best) {
            best = values[i];
        }
        i += 1;
    }
    return best;
}
fun maximum(values: int[], length: int): int {
    if (length == 0) {
        return -1;
    }
    var best: int = values[0];
    var i: int = 1;
    while (i < length) {
        if (values[i] > best) {
            best = values[i];
        }
        i += 1;
    }
    return best;
}
