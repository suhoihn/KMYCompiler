fun binarySearch(values: int[], length: int, target: int): int {
    var low: int = 0;
    var high: int = length - 1;
    while (low <= high) {
        var mid: int = low + (high - low) / 2;
        if (values[mid] == target) {
            return mid;
        }
        if (values[mid] < target) {
            low = mid + 1;
        }
        else {
            high = mid - 1;
        }
    }
    return -1;
}
fun bubbleSort(values: int[], length: int) {
    var end: int = length - 1;
    while (end > 0) {
        var i: int = 0;
        while (i < end) {
            if (values[i] > values[i + 1]) {
                var swap: int = values[i];
                values[i] = values[i + 1];
                values[i + 1] = swap;
            }
            i += 1;
        }
        end -= 1;
    }
}
fun sum(values: int[], length: int): int {
    var result: int = 0;
    var i: int = 0;
    while (i < length) {
        result += values[i];
        i += 1;
    }
    return result;
}
fun countEven(values: int[], length: int): int {
    var result: int = 0;
    var i: int = 0;
    while (i < length) {
        if (values[i] % 2 == 0) {
            result += 1;
        }
        i += 1;
    }
    return result;
}
