class StringQueue {
    let data: string[] = new string[4];
    let head: int = 0;
    let tail: int = 0;
    let size: int = 0;
    let capacity: int = 4;
    init() {
    }
    fun grow() {
        let next: string[] = new string[this.capacity * 2];
        let i: int = 0;
        while (i < this.size) {
            next[i] = this.data[(this.head + i) % this.capacity];
            i += 1;
        }
        this.data = next;
        this.head = 0;
        this.tail = this.size;
        this.capacity *= 2;
    }
    fun enqueue(value: string) {
        if (this.size == this.capacity) {
            this.grow();
        }
        this.data[this.tail] = value;
        this.tail = (this.tail + 1) % this.capacity;
        this.size += 1;
    }
    fun dequeue(): string {
        if (this.size == 0) {
            return "";
        }
        let value: string = this.data[this.head];
        this.head = (this.head + 1) % this.capacity;
        this.size -= 1;
        return value;
    }
    fun length(): int {
        return this.size;
    }
};
