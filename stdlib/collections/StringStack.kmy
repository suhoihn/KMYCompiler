class StringStack {
    let data: string[] = new string[4];
    let size: int = 0;
    let capacity: int = 4;
    init() {
    }
    fun push(value: string) {
        if (this.size == this.capacity) {
            let next: string[] = new string[this.capacity * 2];
            let i: int = 0;
            while (i < this.size) {
                next[i] = this.data[i];
                i += 1;
            }
            this.data = next;
            this.capacity *= 2;
        }
        this.data[this.size] = value;
        this.size += 1;
    }
    fun pop(): string {
        if (this.size == 0) {
            return "";
        }
        this.size -= 1;
        return this.data[this.size];
    }
    fun peek(): string {
        if (this.size == 0) {
            return "";
        }
        return this.data[this.size - 1];
    }
    fun length(): int {
        return this.size;
    }
};
