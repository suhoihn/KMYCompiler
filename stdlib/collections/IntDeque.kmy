class IntDeque {
    let data: int[] = new int[4];
    let head: int = 0;
    let size: int = 0;
    let capacity: int = 4;
    init() {
    }
    fun grow() {
        let next: int[] = new int[this.capacity * 2];
        let i: int = 0;
        while (i < this.size) {
            next[i] = this.data[(this.head + i) % this.capacity];
            i += 1;
        }
        this.data = next;
        this.head = 0;
        this.capacity *= 2;
    }
    fun pushBack(value: int) {
        if (this.size == this.capacity) {
            this.grow();
        }
        this.data[(this.head + this.size) % this.capacity] = value;
        this.size += 1;
    }
    fun pushFront(value: int) {
        if (this.size == this.capacity) {
            this.grow();
        }
        this.head = (this.head + this.capacity - 1) % this.capacity;
        this.data[this.head] = value;
        this.size += 1;
    }
    fun popFront(): int {
        if (this.size == 0) {
            return -1;
        }
        let value: int = this.data[this.head];
        this.head = (this.head + 1) % this.capacity;
        this.size -= 1;
        return value;
    }
    fun popBack(): int {
        if (this.size == 0) {
            return -1;
        }
        let index: int = (this.head + this.size - 1) % this.capacity;
        this.size -= 1;
        return this.data[index];
    }
    fun length(): int {
        return this.size;
    }
};
