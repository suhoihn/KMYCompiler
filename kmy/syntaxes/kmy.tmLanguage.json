{
  "scopeName": "source.kmy",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#identifiers" }
  ],

  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.kmy"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "match": "\\b(if|else|while|for|break|continue|return|let|const|fun|class|new|this)\\b",
          "name": "keyword.control.kmy"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "match": "\\b(int|double|bool|string|void|array|object|any)\\b",
          "name": "storage.type.kmy"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "match": "\\b(true|false|null)\\b",
          "name": "constant.language.kmy"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "match": "\\b\\d+(\\.\\d+)?\\b",
          "name": "constant.numeric.kmy"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.kmy",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.kmy"
            }
          ]
        }
      ]
    },

    "identifiers": {
      "patterns": [
        {
          "match": "\\b(?!if|else|while|for|break|continue|return|let|const|fun|class|new|this|int|double|bool|string|void|array|object|any|true|false|null)[a-zA-Z_][a-zA-Z0-9_]*\\b",
          "name": "variable.other.readwrite.kmy"
        }
      ]
    }
  }
}