{
  "scopeName": "source.kmy",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#strings" },
    { "include": "#numbers" }
  ],

  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.kmy"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "match": "\\b(if|else|while|for|break|continue|return|let|const|fun|class|init|new|this|record|typealias)\\b",
          "name": "keyword.control.kmy"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "match": "\\b(true|false|null)\\b",
          "name": "constant.language.kmy"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "match": "\\b(int|i64|u64|byte|double|f64|bool|string|void|array|object|any)\\b",
          "name": "support.type.kmy"
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*(?=\\()",
          "name": "entity.name.function.kmy"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.kmy",
          "patterns": [
            {
              "match": "\\\\(?:[\\\\\"nrt]|u[0-9a-fA-F]{4})",
              "name": "constant.character.escape.kmy"
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
          "name": "constant.numeric.kmy"
        }
      ]
    }
  }
}
