{
  "scopeName": "source.kmy",
  "patterns": [
    { "include": "#comments" },
    { "include": "#importDeclarations" },
    { "include": "#enumDeclarations" },
    { "include": "#enumAccess" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#strings" },
    { "include": "#numbers" }
  ],

  "repository": {
    "importDeclarations": {
      "patterns": [
        {
          "match": "\\b(import)\\s+(\\\"(?:\\\\.|[^\\\"])*\\\")\\s+(as)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.import.kmy" },
            "2": { "name": "string.quoted.double.kmy" },
            "3": { "name": "keyword.control.import.kmy" },
            "4": { "name": "entity.name.namespace.kmy" }
          }
        }
      ]
    },

    "enumDeclarations": {
      "patterns": [
        {
          "begin": "\\b(enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "keyword.declaration.enum.kmy" },
            "2": { "name": "entity.name.type.enum.kmy" }
          },
          "end": "\\}",
          "patterns": [
            { "include": "#comments" },
            {
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*(?:,|\\}))",
              "name": "constant.other.enum.member.kmy"
            }
          ]
        }
      ]
    },

    "enumAccess": {
      "patterns": [
        {
          "match": "\\b((?:[a-zA-Z_][a-zA-Z0-9_]*::)+)([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.type.enum.kmy" },
            "2": { "name": "constant.other.enum.member.kmy" }
          }
        }
      ]
    },

    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.kmy"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "match": "\\b(if|else|while|for|break|continue|return|let|const|fun|class|init|new|this|record|enum|typealias|import|as|from)\\b",
          "name": "keyword.control.kmy"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "match": "\\b(true|false|null)\\b",
          "name": "constant.language.kmy"
        }
      ]
    },

    "types": {
      "patterns": [
        {
          "match": "\\b(int|i64|u64|byte|double|f64|bool|string|void|array|object|any)\\b",
          "name": "support.type.kmy"
        }
      ]
    },

    "functions": {
      "patterns": [
        {
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*(?=\\()",
          "name": "entity.name.function.kmy"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.kmy",
          "patterns": [
            {
              "match": "\\\\(?:[\\\\\"nrt]|u[0-9a-fA-F]{4})",
              "name": "constant.character.escape.kmy"
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
          "name": "constant.numeric.kmy"
        }
      ]
    }
  }
}
