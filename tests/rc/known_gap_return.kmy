// Former gap, now a regular regression: Block must always pop its cleanup list.
// The untaken return branch must not corrupt cleanup on the normal path.
class Box {
    var value: int = 42;
    init() {}
};

fun probe(flag: bool) {
    let a = new shared Box();
    if (flag) {
        return 0;
    }
    {
        let b = a;
    }
}

probe(false);
