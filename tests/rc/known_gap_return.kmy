// Known compiler-bookkeeping gap: Block must pop its cleanup list even when
// its path terminates. This call takes the normal path, so a should be freed.
class Box {
    var value: int = 42;
    init() {}
};

fun probe(flag: bool) {
    let a = new shared Box();
    if (flag) {
        return 0;
    }
    {
        let b = a;
    }
}

probe(false);
