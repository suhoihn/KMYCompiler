// Pointer stress cases: fields, array elements, nested pointers, and
// pointers to heap-allocated class references.
class Box {
    var value: int = 0;

    init(initial: int) {
        this.value = initial;
    }
};

// Address and mutate a class field.
var box: Box = new Box(10);
var fieldPointer = &box.value;
print(*fieldPointer);
*fieldPointer += 5;
print(box.value);

// Address and mutate an array element.
var numbers = [20, 30, 40];
var elementPointer = &numbers[1];
print(*elementPointer);
*elementPointer = 35;
print(numbers[1]);

// A pointer to a pointer should preserve the original address.
var pointerPointer = &elementPointer;
print(**pointerPointer);
**pointerPointer = 36;
print(numbers[1]);

// A class variable contains a heap-object pointer. Taking its address gives
// a pointer to that reference; dereferencing it recovers the object reference.
var boxReferencePointer = &box;
print((*boxReferencePointer).value);
(*boxReferencePointer).value = 25;
print(box.value);

// Arrays of class references can also be addressed element-wise.
var boxes = [new Box(1), new Box(2)];
var secondBoxPointer = &boxes[1];
print((*secondBoxPointer).value);
(*secondBoxPointer).value += 7;
print(boxes[1].value);
