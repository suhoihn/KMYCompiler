// Prefix returns the new value; postfix returns the old value.
var local: int = 5;
print(++local);
print(local++);
print(local);
print(--local);
print(local--);
print(local);

// The write is an SSA definition and must merge correctly after a branch.
var branchValue: int = 10;
if (true) {
    branchValue++;
} else {
    branchValue--;
}
print(branchValue);

class Counter {
    var value: int = 0;

    init(start: int) {
        this.value = start;
    }

    fun test(): int {
        var old: int = this.value++;
        return old * 10 + ++this.value;
    }
};

var counter: Counter = new Counter(3);
print(counter.test());

var values: int[] = [4, 7];
var index: int = 0;
print(values[index]++);
print(values[index]);

var pointer: int* = malloc(8);
*pointer = 20;
print((*pointer)--);
print(*pointer);
