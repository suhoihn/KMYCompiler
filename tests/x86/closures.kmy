fun makeCounter(start: int): () -> int {
    let value = start;

    return fun(): int {
        value += 1;
        return value;
    };
}

fun makeAccumulator(seed: int): () -> int {
    let state = seed;

    fun next(): int {
        state += 5;
        return state;
    }

    return next;
}

fun makeNestedStepper(start: int): () -> () -> int {
    let value = start;

    return fun(): () -> int {
        return fun(): int {
            value += 2;
            return value;
        };
    };
}

fun main(): int {
    let first = makeCounter(10);
    let second = makeCounter(100);
    print(first());
    print(second());
    print(first());

    let accumulator = makeAccumulator(0);
    print(accumulator());
    print(accumulator());

    let nested = makeNestedStepper(1)();
    print(nested());
    print(nested());

    return 0;
}

main();
