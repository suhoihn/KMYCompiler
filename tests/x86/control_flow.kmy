fun main(): int {
    let total = 0;

    for (let i = 0; i < 5; i += 1) {
        if (i % 2 == 0) {
            total += i;
        } else {
            if (i == 3) {
                total += 10;
            } else {
                total += 0;
            }
        }
    }

    let j = 0;
    while (j < 3) {
        if (j == 1) {
            total += 200;
        } else {
            total += 100;
        }
        j += 1;
    }

    print(total);

    let scopedTotal = 0;
    for (let outer = 0; outer < 3; outer += 1) {
        let inner = 0;
        while (inner < 3) {
            inner += 1;

            if (inner == 2) {
                continue;
            }

            if (outer == 1) {
                if (inner == 3) {
                    break;
                }
            }

            scopedTotal += outer * 10 + inner;
        }
    }

    print(scopedTotal);
    return total;
}

main();
